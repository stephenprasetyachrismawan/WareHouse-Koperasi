{
  "warmupSeconds": 45,
  "denyPatterns": [
    "Fatal error",
    "Uncaught ",
    "Unhandled ",
    "SQLSTATE\\[",
    "npm ERR!",
    "Vite error",
    "Build failed",
    "Address already in use",
    "Failed to listen",
    "Connection refused",
    "Migration failed",
    "PHP Parse error",
    "Laravel development server stopped"
  ],
  "ignorePatterns": [
    "0000-00-00 00:00:00",
    "debug",
    "info",
    "notice"
  ]
}
