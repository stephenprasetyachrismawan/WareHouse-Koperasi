{
  "name": "warehouse-orchestrator",
  "version": "1.0.0",
  "description": "Autonomous GitHub-Issue Orchestrator using Google Antigravity CLI for WareHouse-Koperasi",
  "main": "src/cli/index.ts",
  "type": "commonjs",
  "scripts": {
    "doctor": "npx ts-node src/cli/doctor.ts",
    "config:show": "npx ts-node src/cli/config-cli.ts show",
    "config:set-model": "npx ts-node src/cli/config-cli.ts set-model",
    "config:set-agent": "npx ts-node src/cli/config-cli.ts set-agent",
    "config:validate": "npx ts-node src/cli/config-cli.ts validate",
    "labels:provision": "npx ts-node src/cli/labels-cli.ts provision",
    "auth:user": "npx ts-node src/cli/auth-cli.ts user",
    "auth:status": "npx ts-node src/cli/auth-cli.ts status",
    "tmux:start": "./scripts/tmux-start.sh",
    "tmux:stop": "./scripts/tmux-stop.sh",
    "tmux:restart": "./scripts/tmux-stop.sh && ./scripts/tmux-start.sh",
    "tmux:status": "./scripts/tmux-status.sh",
    "detector": "npx ts-node src/cli/detector-runner.ts",
    "detector:start": "./scripts/tmux-start.sh detector",
    "detector:stop": "./scripts/tmux-stop.sh detector",
    "detector:restart": "./scripts/tmux-stop.sh detector && ./scripts/tmux-start.sh detector",
    "detector:status": "npx ts-node src/cli/detector-cli.ts status",
    "detector:logs": "npx ts-node src/cli/detector-cli.ts logs",
    "dev-session:start": "./scripts/tmux-start.sh dev",
    "dev-session:stop": "./scripts/tmux-stop.sh dev",
    "dev-session:restart": "./scripts/tmux-stop.sh dev && ./scripts/tmux-start.sh dev",
    "dev-session:status": "./scripts/dev-supervisor.sh status",
    "dev-session:health": "npx ts-node src/cli/dev-health-cli.ts",
    "dev-session:logs": "tail -n 100 /srv/warehouse-koperasi/logs/composer-dev/dev-supervisor.log 2>/dev/null || echo 'No logs yet'",
    "jobs:list": "npx ts-node src/cli/jobs-cli.ts list",
    "jobs:show": "npx ts-node src/cli/jobs-cli.ts show",
    "jobs:retry": "npx ts-node src/cli/jobs-cli.ts retry",
    "jobs:cancel": "npx ts-node src/cli/jobs-cli.ts cancel",
    "dry-run:local": "npx ts-node src/cli/dry-run-cli.ts",
    "smoke:agy": "npx ts-node src/cli/smoke-cli.ts agy",
    "smoke:tmux": "npx ts-node src/cli/smoke-cli.ts tmux",
    "smoke:composer-dev": "npx ts-node src/cli/smoke-cli.ts composer-dev",
    "smoke:github": "npx ts-node src/cli/smoke-cli.ts github",
    "orchestrator:enable": "npx ts-node src/cli/orchestrator-cli.ts enable",
    "orchestrator:disable": "npx ts-node src/cli/orchestrator-cli.ts disable",
    "orchestrator:status": "npx ts-node src/cli/orchestrator-cli.ts status",
    "test": "npx ts-node tests/run-tests.ts"
  },
  "dependencies": {
    "@octokit/rest": "^20.1.0",
    "commander": "^12.0.0",
    "dotenv": "^16.4.5",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/sqlite3": "^3.1.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
