#!/usr/bin/env bash
set -euo pipefail

WORKTREE_DIR="$(pwd)"
LOG_DIR="${WORKTREE_DIR}/.agent-runtime/logs"
mkdir -p "${LOG_DIR}"
LOG_FILE="${LOG_DIR}/final-test.log"
START_TIME=$(date +%s)

echo "=== FINAL LOCAL QUALITY GATE ===" > "${LOG_FILE}"

EXIT_CODE=0

echo "--- 1. Pint Formatting ---" >> "${LOG_FILE}"
vendor/bin/pint --test >> "${LOG_FILE}" 2>&1 || EXIT_CODE=$?

if [ ${EXIT_CODE} -eq 0 ]; then
  echo "--- 2. PHPStan Static Analysis ---" >> "${LOG_FILE}"
  vendor/bin/phpstan analyse --no-progress >> "${LOG_FILE}" 2>&1 || EXIT_CODE=$?
fi

if [ ${EXIT_CODE} -eq 0 ]; then
  echo "--- 3. Full Test Suite ---" >> "${LOG_FILE}"
  php artisan test --compact >> "${LOG_FILE}" 2>&1 || EXIT_CODE=$?
fi

# Conditional frontend build check if resources or vite config changed
if [ ${EXIT_CODE} -eq 0 ] && git diff --name-only HEAD | grep -E "^resources/|^vite\.config" > /dev/null 2>&1; then
  echo "--- 4. Frontend Asset Build ---" >> "${LOG_FILE}"
  npm run build >> "${LOG_FILE}" 2>&1 || EXIT_CODE=$?
fi

END_TIME=$(date +%s)
DURATION=$((END_TIME - START_TIME))

if [ ${EXIT_CODE} -eq 0 ]; then
  echo "TOOL: agent-final-test"
  echo "STATUS: PASS"
  echo "EXIT_CODE: 0"
  echo "DURATION_SECONDS: ${DURATION}"
  echo "LOG: .agent-runtime/logs/final-test.log"
  exit 0
else
  PRIMARY_ERR=$(tail -n 15 "${LOG_FILE}" | grep -E "FAILED|Failed|Error|FAIL" | head -n 1 || echo "Final local gate failed.")
  echo "TOOL: agent-final-test"
  echo "STATUS: FAIL"
  echo "EXIT_CODE: ${EXIT_CODE}"
  echo "DURATION_SECONDS: ${DURATION}"
  echo "PRIMARY_ERROR: ${PRIMARY_ERR}"
  echo "LOG: .agent-runtime/logs/final-test.log"
  echo "TAIL:"
  tail -n 15 "${LOG_FILE}"
  exit ${EXIT_CODE}
fi
