#!/usr/bin/env bash
set -euo pipefail

WORKTREE_DIR="$(pwd)"
LOG_DIR="${WORKTREE_DIR}/.agent-runtime/logs"
mkdir -p "${LOG_DIR}"
LOG_FILE="${LOG_DIR}/baseline.log"
START_TIME=$(date +%s)

echo "=== Baseline Check ===" > "${LOG_FILE}"

EXIT_CODE=0
php artisan test --compact >> "${LOG_FILE}" 2>&1 || EXIT_CODE=$?

END_TIME=$(date +%s)
DURATION=$((END_TIME - START_TIME))

if [ ${EXIT_CODE} -eq 0 ]; then
  echo "TOOL: agent-baseline"
  echo "STATUS: PASS"
  echo "EXIT_CODE: 0"
  echo "DURATION_SECONDS: ${DURATION}"
  echo "LOG: .agent-runtime/logs/baseline.log"
  exit 0
else
  PRIMARY_ERR=$(tail -n 10 "${LOG_FILE}" | grep -E "FAILED|Error|FAIL" | head -n 1 || echo "Baseline tests failed")
  echo "TOOL: agent-baseline"
  echo "STATUS: FAIL"
  echo "EXIT_CODE: ${EXIT_CODE}"
  echo "DURATION_SECONDS: ${DURATION}"
  echo "PRIMARY_ERROR: ${PRIMARY_ERR}"
  echo "LOG: .agent-runtime/logs/baseline.log"
  echo "TAIL:"
  tail -n 15 "${LOG_FILE}"
  exit ${EXIT_CODE}
fi
