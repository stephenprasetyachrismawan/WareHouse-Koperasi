#!/usr/bin/env bash
set -euo pipefail

WORKTREE_DIR="$(pwd)"
LOG_DIR="${WORKTREE_DIR}/.agent-runtime/logs"
mkdir -p "${LOG_DIR}"
LOG_FILE="${LOG_DIR}/dev-health.log"
START_TIME=$(date +%s)

echo "=== COMPOSER DEV HEALTH CHECK ===" > "${LOG_FILE}"

EXIT_CODE=0
HEALTH_OUTPUT=""

# Query dev-supervisor health via helper script or file check
if [ -f "/srv/warehouse-koperasi/state/dev-health.json" ]; then
  HEALTH_OUTPUT=$(cat /srv/warehouse-koperasi/state/dev-health.json)
  STATUS_VAL=$(echo "${HEALTH_OUTPUT}" | grep -o '"status"[[:space:]]*:[[:space:]]*"[^"]*"' | sed 's/.*"[[:space:]]*:[[:space:]]*"//; s/"//g' || echo "unknown")
  if [ "${STATUS_VAL}" != "HEALTHY" ]; then
    EXIT_CODE=1
  fi
else
  HEALTH_OUTPUT='{"status":"UNCHECKED","message":"dev-health.json state file not found"}'
  EXIT_CODE=1
fi

echo "${HEALTH_OUTPUT}" >> "${LOG_FILE}"

END_TIME=$(date +%s)
DURATION=$((END_TIME - START_TIME))

if [ ${EXIT_CODE} -eq 0 ]; then
  echo "TOOL: agent-dev-health"
  echo "STATUS: PASS"
  echo "EXIT_CODE: 0"
  echo "DURATION_SECONDS: ${DURATION}"
  echo "LOG: .agent-runtime/logs/dev-health.log"
  echo "DETAILS: ${HEALTH_OUTPUT}"
  exit 0
else
  echo "TOOL: agent-dev-health"
  echo "STATUS: FAIL"
  echo "EXIT_CODE: 1"
  echo "DURATION_SECONDS: ${DURATION}"
  echo "PRIMARY_ERROR: Composer development server health check failed."
  echo "LOG: .agent-runtime/logs/dev-health.log"
  echo "TAIL:"
  echo "${HEALTH_OUTPUT}"
  exit 1
fi
