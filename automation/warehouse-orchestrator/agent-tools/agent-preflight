#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKTREE_DIR="$(pwd)"
LOG_DIR="${WORKTREE_DIR}/.agent-runtime/logs"
mkdir -p "${LOG_DIR}"
LOG_FILE="${LOG_DIR}/preflight.log"
START_TIME=$(date +%s)

echo "Preflight check started at $(date)" > "${LOG_FILE}"

ERRORS=()

if [ ! -f "${WORKTREE_DIR}/artisan" ]; then
  ERRORS+=("Not inside a valid Laravel repository worktree.")
fi

if [ ! -f "${WORKTREE_DIR}/composer.json" ]; then
  ERRORS+=("Missing composer.json.")
fi

if [ ! -d "${WORKTREE_DIR}/vendor" ]; then
  ERRORS+=("Missing vendor directory. Dependencies not installed.")
fi

END_TIME=$(date +%s)
DURATION=$((END_TIME - START_TIME))

if [ ${#ERRORS[@]} -eq 0 ]; then
  echo "TOOL: agent-preflight"
  echo "STATUS: PASS"
  echo "EXIT_CODE: 0"
  echo "DURATION_SECONDS: ${DURATION}"
  echo "LOG: .agent-runtime/logs/preflight.log"
  exit 0
else
  echo "TOOL: agent-preflight"
  echo "STATUS: FAIL"
  echo "EXIT_CODE: 1"
  echo "DURATION_SECONDS: ${DURATION}"
  echo "PRIMARY_ERROR: ${ERRORS[0]}"
  echo "LOG: .agent-runtime/logs/preflight.log"
  echo "TAIL:"
  printf '%s\n' "${ERRORS[@]}"
  exit 1
fi
