#!/usr/bin/env bash
set -euo pipefail

FILTER=""
while [[ $# -gt 0 ]]; do
  case $1 in
    --filter)
      FILTER="$2"
      shift 2
      ;;
    *)
      FILTER="$1"
      shift
      ;;
  esac
done

WORKTREE_DIR="$(pwd)"
LOG_DIR="${WORKTREE_DIR}/.agent-runtime/logs"
mkdir -p "${LOG_DIR}"
LOG_FILE="${LOG_DIR}/tdd-red.log"
START_TIME=$(date +%s)

echo "=== TDD RED PHASE: ${FILTER} ===" > "${LOG_FILE}"

EXIT_CODE=0
if [ -n "${FILTER}" ]; then
  php artisan test --filter="${FILTER}" --compact >> "${LOG_FILE}" 2>&1 || EXIT_CODE=$?
else
  php artisan test --compact >> "${LOG_FILE}" 2>&1 || EXIT_CODE=$?
fi

END_TIME=$(date +%s)
DURATION=$((END_TIME - START_TIME))

# TDD RED requires test execution to FAIL due to expected missing feature/assertion
if [ ${EXIT_CODE} -ne 0 ]; then
  PRIMARY_ERR=$(tail -n 15 "${LOG_FILE}" | grep -E "FAILED|Failed|Error" | head -n 1 || echo "Expected test failure confirmed.")
  echo "TOOL: agent-tdd-red"
  echo "STATUS: PASS"
  echo "EXIT_CODE: 0"
  echo "DURATION_SECONDS: ${DURATION}"
  echo "PRIMARY_ERROR: ${PRIMARY_ERR}"
  echo "LOG: .agent-runtime/logs/tdd-red.log"
  echo "TAIL:"
  tail -n 10 "${LOG_FILE}"
  exit 0
else
  echo "TOOL: agent-tdd-red"
  echo "STATUS: FAIL"
  echo "EXIT_CODE: 1"
  echo "DURATION_SECONDS: ${DURATION}"
  echo "PRIMARY_ERROR: Test passed unexpectedly during RED phase. Test must fail for the intended missing feature."
  echo "LOG: .agent-runtime/logs/tdd-red.log"
  echo "TAIL:"
  tail -n 10 "${LOG_FILE}"
  exit 1
fi
