#!/usr/bin/env bash
set -euo pipefail

WORKTREE_DIR="$(pwd)"
LOG_DIR="${WORKTREE_DIR}/.agent-runtime/logs"
mkdir -p "${LOG_DIR}"
LOG_FILE="${LOG_DIR}/git-status.log"
START_TIME=$(date +%s)

git status --short > "${LOG_FILE}" 2>&1

END_TIME=$(date +%s)
DURATION=$((END_TIME - START_TIME))

echo "TOOL: agent-git-status"
echo "STATUS: PASS"
echo "EXIT_CODE: 0"
echo "DURATION_SECONDS: ${DURATION}"
echo "LOG: .agent-runtime/logs/git-status.log"
echo "TAIL:"
tail -n 20 "${LOG_FILE}"
exit 0
