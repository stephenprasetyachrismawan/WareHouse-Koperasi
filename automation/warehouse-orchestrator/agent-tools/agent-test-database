#!/usr/bin/env bash
set -euo pipefail

WORKTREE_DIR="$(pwd)"
LOG_DIR="${WORKTREE_DIR}/.agent-runtime/logs"
mkdir -p "${LOG_DIR}"
LOG_FILE="${LOG_DIR}/test-database.log"
START_TIME=$(date +%s)

echo "=== ISOLATED DATABASE INTEGRATION TESTS ===" > "${LOG_FILE}"

EXIT_CODE=0
php artisan config:clear >> "${LOG_FILE}" 2>&1 || true
APP_ENV=testing php artisan migrate:fresh --force >> "${LOG_FILE}" 2>&1 || EXIT_CODE=$?
if [ ${EXIT_CODE} -eq 0 ]; then
  APP_ENV=testing php artisan test --compact >> "${LOG_FILE}" 2>&1 || EXIT_CODE=$?
fi

END_TIME=$(date +%s)
DURATION=$((END_TIME - START_TIME))

if [ ${EXIT_CODE} -eq 0 ]; then
  echo "TOOL: agent-test-database"
  echo "STATUS: PASS"
  echo "EXIT_CODE: 0"
  echo "DURATION_SECONDS: ${DURATION}"
  echo "LOG: .agent-runtime/logs/test-database.log"
  exit 0
else
  PRIMARY_ERR=$(tail -n 15 "${LOG_FILE}" | grep -E "FAILED|Failed|Error" | head -n 1 || echo "Database integration tests failed.")
  echo "TOOL: agent-test-database"
  echo "STATUS: FAIL"
  echo "EXIT_CODE: ${EXIT_CODE}"
  echo "DURATION_SECONDS: ${DURATION}"
  echo "PRIMARY_ERROR: ${PRIMARY_ERR}"
  echo "LOG: .agent-runtime/logs/test-database.log"
  echo "TAIL:"
  tail -n 15 "${LOG_FILE}"
  exit ${EXIT_CODE}
fi
