# Reference env for the deployed Docker development runtime.
#
# This is DOCUMENTATION ONLY -- copy it to a real, unversioned .env on the
# VPS (e.g. /srv/warehouse-koperasi/deploy/.env) and fill in real values
# there. Never commit that file. Never bake it into the image (see
# .dockerignore). docker/compose.yaml loads it via `env_file:`.
#
# This file intentionally preserves the current approved development
# topology: SQLite + database-backed cache/queue/session. It does NOT
# introduce PostgreSQL/Redis on the VPS -- CI verifies compatibility with
# both separately using disposable service containers. Production remains
# PostgreSQL + Redis per ADR 0011; this is the development runtime only.

############################################
# APPLICATION RUNTIME
############################################
APP_NAME="Warehouse Koperasi"
APP_ENV=development
# Generate with: docker compose run --rm app php artisan key:generate --show
# Then paste the result here -- never commit the real value.
APP_KEY=
APP_DEBUG=false
APP_URL=https://wh.stevewithcode.net
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

############################################
# DATABASE — SQLite, persisted outside the image
############################################
DB_CONNECTION=sqlite
# Matches deploy/compose.yaml's sqlite-data volume mount target. This path
# must never resolve inside database/ itself (that directory ships the
# baked-in migrations/factories/seeders).
DB_DATABASE=/var/www/html/storage/database/database.sqlite

############################################
# CACHE / QUEUE / SESSION — database-backed, matching current dev topology
############################################
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_DOMAIN=.stevewithcode.net
SESSION_SECURE_COOKIE=true

############################################
# REVERB — INTERNAL (server/container-to-container, inside the Docker network)
# The app/queue/scheduler containers publish events to the reverb
# container by its Compose service name, over plain HTTP -- this traffic
# never leaves the Docker network, so TLS is unnecessary here.
############################################
REVERB_APP_ID=
# Public app key, safe to also appear in VITE_REVERB_APP_KEY below.
REVERB_APP_KEY=
# SECRET — never expose to the browser, never put in a VITE_* value or a
# Docker build ARG.
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_ALLOWED_ORIGINS=https://wh.stevewithcode.net,https://wh.stevewithcode.com
BROADCAST_CONNECTION=reverb

############################################
# REVERB — PUBLIC / VITE (browser-facing, baked into the frontend build at
# image-build time via Docker build ARGs — see Dockerfile's `frontend`
# stage). The browser cannot resolve Docker service names, so this MUST be
# the public hostname, reached through the existing Cloudflare tunnel's
# path-based routing (path ^/(app|apps) on wh.stevewithcode.net/.com -> the
# reverb container's port 8080).
#
# These four values are passed as `docker build --build-arg VITE_...`
# during the GitHub Actions image build, NOT read from this file at
# runtime — they are listed here only so the two sides of the Reverb split
# are documented next to each other.
############################################
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=wh.stevewithcode.net
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

############################################
# FILESYSTEM — private evidence storage, persisted outside the image
############################################
FILESYSTEM_DISK=local
PRIVATE_STORAGE_DRIVER=local

############################################
# LOGGING
############################################
LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=info

############################################
# GOOGLE OAUTH — SECRET, never in build args/VITE_*
############################################
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
