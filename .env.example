APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
VITE_DEV_SERVER_ORIGIN=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
PRIVATE_STORAGE_DRIVER=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

VITE_APP_NAME="${APP_NAME}"

# Reverb (private realtime broadcasting). Generate per-environment secrets —
# never reuse across environments, never commit real values.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Production: set to the public hostname behind your TLS-terminating proxy
# (e.g. wh.stevewithcode.net), scheme=https, port=443. Never leave a
# wildcard/unrestricted origin in production — see config/reverb.php
# allowed_origins.
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
# Comma-separated origin allowlist. Production MUST set this to the exact
# application origin(s), e.g. https://wh.stevewithcode.net — never leave
# empty/wildcard in production (config/reverb.php refuses a wildcard by
# default once APP_ENV=production).
REVERB_ALLOWED_ORIGINS=

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# FCM (web push). Server-side HTTP v1 API — the service account JSON must
# never be committed; store it outside the repo and reference its path only.
# The values below are PUBLIC Firebase web-app config (safe to ship to the
# browser by Firebase's own design) — do not confuse them with the service
# account credential above.
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
